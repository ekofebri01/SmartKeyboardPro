{
  "entities": {
    "LearnedWord": {
      "collection": "users/{userId}/learned_words",
      "fields": {
        "word": "string",
        "frequency": "number",
        "lastUsed": "timestamp"
      }
    },
    "Snippet": {
      "collection": "users/{userId}/snippets",
      "fields": {
        "content": "string",
        "createdAt": "timestamp"
      }
    },
    "AutoTextShortcut": {
      "collection": "users/{userId}/auto_text_shortcuts",
      "fields": {
        "id": "string",
        "shortcut": "string",
        "fullText": "string",
        "userId": "string",
        "updatedAt": "timestamp"
      }
    },
    "UserBackup": {
      "collection": "users/{userId}/backups",
      "fields": {
        "backupId": "string",
        "createdAt": "timestamp",
        "deviceName": "string",
        "appVersion": "string",
        "themeConfigJson": "string",
        "learnedWordsJson": "string",
        "clipboardSnippetsJson": "string",
        "itemCount": "number"
      }
    },
    "UserSettings": {
      "collection": "users/{userId}/settings",
      "fields": {
        "updatedAt": "timestamp",
        "themeConfigJson": "string"
      }
    }
  }
}
